{
  "name": "nintendo-museum-cronjob",
  "version": "1.0.0",
  "description": "Nintendo Museum ticket availability checker with email notifications",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "check": "tsc && node dist/index.js --once"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "puppeteer": "^24.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.3"
  }
}
